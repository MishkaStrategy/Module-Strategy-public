From: Strategy Factory integration
Subject: [PATCH] Explicitly allow integrated Core 0.4.2 v0.4 exports

Related: #220, Draft PR #218
Base: 9b7cc5cac837f8d66c691117143e0dcb9cf2d8f8

This deliberately uses an explicit supported-version set. It does not accept arbitrary
0.4.x and does not relax metric, schema, module-version or integrity validation.

---
 modules/results_aggregator/src/modular_results_registry/core_adapter_import.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/modules/results_aggregator/src/modular_results_registry/core_adapter_import.py b/modules/results_aggregator/src/modular_results_registry/core_adapter_import.py
index 442fbec..strategy-factory-review 100644
--- a/modules/results_aggregator/src/modular_results_registry/core_adapter_import.py
+++ b/modules/results_aggregator/src/modular_results_registry/core_adapter_import.py
@@ -18,6 +18,9 @@ from .models import (
 )
 
 
+_SUPPORTED_CORE_EXPORT_VERSIONS = frozenset({"0.4.0", "0.4.2"})
+
+
 def adapt_core_v04_export(
     export_directory: str | Path,
     context: CoreRunContext,
@@ -52,7 +55,7 @@ def adapt_core_v04_export(
     manifest = _require_mapping(run_document.get("manifest"), "run.manifest")
     core_run_id = _require_string(manifest.get("run_id"), "manifest.run_id")
     kernel_version = _require_string(manifest.get("kernel_version"), "manifest.kernel_version")
-    if kernel_version != "0.4.0":
+    if kernel_version not in _SUPPORTED_CORE_EXPORT_VERSIONS:
         raise UnsupportedSchemaError(f"unsupported Core version: {kernel_version}")
     producer_data_hash = _require_string(manifest.get("data_hash"), "manifest.data_hash")
     producer_config_hash = _require_string(manifest.get("config_hash"), "manifest.config_hash")
-- 
2.0
