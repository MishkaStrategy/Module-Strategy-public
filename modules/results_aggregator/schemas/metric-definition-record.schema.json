{
  "$id": "urn:modular-results-registry:metric-definition-record:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregation_method": {
      "minLength": 1,
      "type": "string"
    },
    "definition_version": {
      "minLength": 1,
      "type": "string"
    },
    "direction": {
      "enum": [
        "MAXIMIZE",
        "MINIMIZE",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "formula": {
      "minLength": 1,
      "type": "string"
    },
    "metric_name": {
      "minLength": 1,
      "type": "string"
    },
    "missing_value_policy": {
      "minLength": 1,
      "type": "string"
    },
    "owner_module": {
      "minLength": 1,
      "type": "string"
    },
    "precision": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "producer": {
      "minLength": 1,
      "type": "string"
