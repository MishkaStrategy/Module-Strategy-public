{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modular-strategy:external-execution-receipt:1",
  "title": "Signed external execution receipt v1",
  "description": "Controller signs canonical JSON encoding of {schema_version, key_id, payload}. Publisher pins the controller public key and atomically enforces global admission_id replay protection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "key_id", "payload", "signature"],
  "properties": {
    "schema_version": {"const": 1},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "payload": {"$ref": "#/$defs/payload"},
    "signature": {"type": "string", "contentEncoding": "base64", "minLength": 88, "maxLength": 88, "pattern": "^[A-Za-z0-9+/]{86}==$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"
    },
    "outputPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!.*(?:^|/)[^/]*\\.(?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:\\.|/|$))[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?:/[A-Za-z0-9][A-Za-z0-9._-]{0,127})*$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/outputPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission_id", "repository", "source_sha", "workflow_digest", "runtime_id", "workload_id",
        "workload_digest", "material_digest", "policy_id", "policy_digest", "environment_id",
        "admission_digest", "observed_provider", "observed_resource_policy_digest", "observed_network_policy_digest",
        "executor", "started_at", "ended_at", "destroyed_at", "outcome", "exit_code", "outputs"
      ],
      "properties": {
        "admission_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "repository": {"type": "string", "format": "uri"},
        "source_sha": {"$ref": "#/$defs/gitSha"},
        "workflow_digest": {"$ref": "#/$defs/sha256"},
        "runtime_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "workload_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "workload_digest": {"$ref": "#/$defs/sha256"},
        "material_digest": {"$ref": "#/$defs/sha256"},
        "policy_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "policy_digest": {"$ref": "#/$defs/sha256"},
        "environment_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "admission_digest": {"$ref": "#/$defs/sha256"},
        "observed_provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider_id", "run_id", "attempt"],
          "properties": {
            "provider_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "attempt": {"type": "integer", "minimum": 1}
          }
        },
        "observed_resource_policy_digest": {"$ref": "#/$defs/sha256"},
        "observed_network_policy_digest": {"$ref": "#/$defs/sha256"},
        "executor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executor_id", "ephemeral", "image_digest", "image_os", "image_arch", "observed_os", "observed_arch", "created_at"],
          "properties": {
            "executor_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "ephemeral": {"const": true},
            "image_digest": {"$ref": "#/$defs/sha256"},
            "image_os": {"enum": ["linux", "darwin", "windows"]},
            "image_arch": {"enum": ["x86_64", "aarch64", "arm64", "AMD64"]},
            "observed_os": {"enum": ["linux", "darwin", "windows"]},
            "observed_arch": {"enum": ["x86_64", "aarch64", "arm64", "AMD64"]},
            "created_at": {"$ref": "#/$defs/timestamp"}
          }
        },
        "started_at": {"$ref": "#/$defs/timestamp"},
        "ended_at": {"$ref": "#/$defs/timestamp"},
        "destroyed_at": {"$ref": "#/$defs/timestamp"},
        "outcome": {"enum": ["passed", "failed", "cancelled", "timed_out"]},
        "exit_code": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
        "outputs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/output"}}
      }
    }
  }
}
