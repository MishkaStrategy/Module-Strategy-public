{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modular-strategy:external-publication-receipt:1",
  "title": "Signed local external-publication receipt v1",
  "description": "A local reference receipt binds a ledger publication ID and verified execution publication to the exact execution bundle bytes staged as the artifact in a local content-addressed store. authorization_claim is an unauthenticated caller claim and is not acceptance-eligible. This receipt does not prove key custody, protected storage, global replay protection, or destination immutability.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "key_id", "payload", "signature"],
  "properties": {
    "schema_version": {"const": 1},
    "key_id": {"$ref": "#/$defs/identifier"},
    "payload": {"$ref": "#/$defs/payload"},
    "signature": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 88,
      "maxLength": 88,
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"
    },
    "byteSize": {"type": "integer", "minimum": 0, "maximum": 2147483648},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_id", "authorization_claim", "admission", "execution",
        "publisher", "destination", "artifact", "timestamps", "outcome"
      ],
      "properties": {
        "publication_id": {"$ref": "#/$defs/uuid"},
        "authorization_claim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authorization_id", "authorization_digest"],
          "properties": {
            "authorization_id": {"$ref": "#/$defs/uuid"},
            "authorization_digest": {"$ref": "#/$defs/sha256"}
          }
        },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["admission_id", "admission_digest"],
          "properties": {
            "admission_id": {"$ref": "#/$defs/uuid"},
            "admission_digest": {"$ref": "#/$defs/sha256"}
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publication_id", "receipt_digest", "bundle_digest", "bundle_size_bytes"
          ],
          "properties": {
            "publication_id": {"$ref": "#/$defs/sha256"},
            "receipt_digest": {"$ref": "#/$defs/sha256"},
            "bundle_digest": {"$ref": "#/$defs/sha256"},
            "bundle_size_bytes": {"$ref": "#/$defs/byteSize"}
          }
        },
        "publisher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publisher_id", "policy_digest"],
          "properties": {
            "publisher_id": {"$ref": "#/$defs/identifier"},
            "policy_digest": {"$ref": "#/$defs/sha256"}
          }
        },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind", "store_id", "store_root", "namespace", "object_key",
            "object_id", "object_version"
          ],
          "properties": {
            "kind": {"const": "local_staging"},
            "store_id": {"$ref": "#/$defs/identifier"},
            "store_root": {"type": "string", "minLength": 1, "maxLength": 4096},
            "namespace": {"$ref": "#/$defs/identifier"},
            "object_key": {
              "type": "string",
              "pattern": "^objects/sha256/[a-f0-9]{64}$"
            },
            "object_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "object_version": {"$ref": "#/$defs/sha256"}
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "size_bytes"],
          "properties": {
            "sha256": {"$ref": "#/$defs/sha256"},
            "size_bytes": {"$ref": "#/$defs/byteSize"}
          }
        },
        "timestamps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reserved_at", "in_flight_at", "verified_at", "committed_at"
          ],
          "properties": {
            "reserved_at": {"$ref": "#/$defs/timestamp"},
            "in_flight_at": {"$ref": "#/$defs/timestamp"},
            "verified_at": {"$ref": "#/$defs/timestamp"},
            "committed_at": {"$ref": "#/$defs/timestamp"}
          }
        },
        "outcome": {"const": "committed"}
      }
    }
  }
}
